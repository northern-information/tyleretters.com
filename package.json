{
  "name": "tyleretters.com",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/styles.css -o ./_site/assets/styles.css --minify",
    "build:eleventy": "eleventy",
    "build": "npm run build:css && npm run build:eleventy",
    "dev:css": "tailwindcss -i ./assets/styles.css -o ./_site/assets/styles.css --watch",
    "dev:eleventy": "eleventy --serve",
    "dev": "npm-run-all -p dev:css dev:eleventy"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.8",
    "@tailwindcss/cli": "4.3.5",
    "tailwindcss": "4.3.5",
    "markdown-it": "15.0.3",
    "npm-run-all": "4.1.5"
  }
}
